# En-têtes HTTP appliqués par Netlify (sans effet sur GitHub Pages)

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Police : ne change jamais sous ce nom
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images : gardées 30 jours par le navigateur.
# Pour remplacer une image, donne-lui un nouveau nom de fichier (sinon l'ancienne peut rester affichée).
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon-32.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
