# En-têtes HTTP appliqués par Netlify (sans effet sur GitHub Pages)

# Content-Security-Policy : pas de restriction des scripts (elle bloquerait le badge que
# Netlify injecte). Elle empêche l'intégration du site ailleurs, les plugins et l'envoi
# de formulaires vers un autre service que FormSubmit.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formsubmit.co; upgrade-insecure-requests

# Police : ne change jamais sous ce nom
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images : gardées 30 jours par le navigateur.
# Pour remplacer une image, donne-lui un nouveau nom de fichier (sinon l'ancienne peut rester affichée).
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon-32.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
